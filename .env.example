# Optional path to a YAML/JSON config file (see config/config.example.yml)
#CONFIG_FILE=/etc/webitel/ai-hub.yml

# Log level: debug, info, warn, error (default: info)
#LOG_LEVEL=info
#LOG_JSON=false
#LOG_OTEL=false
#LOG_CONSOLE=true
#LOG_FILE=

# Required PostgreSQL DSN
POSTGRES_DSN=postgres://user:pass@127.0.0.1:5432/webitel?application_name=webitel-ai-hub&sslmode=disable&connect_timeout=10
#POSTGRES_MAX_OPEN_CONNS=0
# Optional read-replica DSNs (comma-separated)
#POSTGRES_STANDBY_DSN=postgres://user:pass@127.0.0.1:5433/webitel?sslmode=disable&connect_timeout=10

# Health probes (/livez, /readyz, /healthz). Empty address disables them.
#HEALTH_ADDRESS=127.0.0.1:10239
# Seconds before sd_notify reports READY=1 anyway. Also the fx start budget.
#HEALTH_START_TIMEOUT=60
# Shutdown drain budget in seconds. 0 uses the healthfx default (DrainHold + 5s).
#HEALTH_STOP_TIMEOUT=20

# OpenTelemetry: see .env.otel.example
